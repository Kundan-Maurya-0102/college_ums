# ── Django core ──────────────────────────────────────────────
# SECRET_KEY is required; the app refuses to start without it.
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-with-a-random-50-plus-character-key
# False for any deployed environment. True only on your own machine.
DEBUG=False
# Comma-separated exact hosts for this deployment.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated full origins (scheme + host) allowed to POST, e.g. https://ums.college.edu
CSRF_TRUSTED_ORIGINS=

# ── College branding (per deployment; nothing college-specific in code) ──
COLLEGE_NAME=My College
# Static path under /static/ (e.g. images/logo.png), or a full https URL. Blank = icon fallback.
COLLEGE_LOGO=images/college_logo.jpg
PRIMARY_COLOR=#000080
COLLEGE_EMAIL=info@example.com
COLLEGE_PHONE=+91 00000 00000
# Optional public website page details (blank = hidden)
COLLEGE_ADDRESS=My College, City, State - PIN
COLLEGE_WEBSITE=https://www.example.com
COLLEGE_AFFILIATION=State Board of Technical Education
COLLEGE_ESTABLISHED=2024
COLLEGE_PRINCIPAL_NAME=

# Twilio WhatsApp (get from twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# College Portal URL (used in set-password / WhatsApp links)
PORTAL_URL=http://127.0.0.1:8000

# Optional: Google Gemini key for the AI chatbot
GEMINI_API_KEY=

# ── Limits ───────────────────────────────────────────────────
# Max CSV size accepted by the bulk upload form (MB).
CSV_MAX_UPLOAD_MB=5
# Set-password / credential links expire after this many hours.
PASSWORD_TOKEN_TIMEOUT_HOURS=48

# ── Local development only (ignored when DEBUG=False) ────────
# Password for demo students created by generate_data.py. Never set in production.
SEED_STUDENT_PASSWORD=

# Optional: Postgres (for production/scale)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=college_ums
# DB_USER=college_ums
# DB_PASSWORD=change_me
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Optional security (used when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
# LOG_LEVEL=INFO

# ── Login brute-force protection ───────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Reverse proxy ──────────────────────────────────────────────────────
# Set true only behind Caddy/nginx so X-Forwarded-For is trusted.
TRUST_PROXY_HEADERS=false

# ── Security headers ───────────────────────────────────────────────────
# Override the default CSP only if you add external scripts/fonts.
# SECURITY_CSP=default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# ── Upload limits ──────────────────────────────────────────────────────
BANNER_MAX_UPLOAD_MB=4
MATERIAL_MAX_UPLOAD_MB=10

# ── Error tracking (optional) ──────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_ENV=production
# SENTRY_TRACES_RATE=0.0
