# Caddy for one college deployment. DOMAIN comes from the deployment .env.
{$DOMAIN:localhost} {
	encode zstd gzip

	# Uploaded files (assignments, materials, banners, CSV history).
	# Served by Caddy because Django only serves /media/ when DEBUG=True.
	handle_path /media/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=86400"
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	reverse_proxy web:8000
}
