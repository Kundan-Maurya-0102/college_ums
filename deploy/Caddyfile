# Caddy for one college deployment. DOMAIN comes from the deployment .env.
{$DOMAIN:localhost} {
	encode zstd gzip

	# /media/* is intentionally NOT served from disk: student CSV imports and other
	# uploads contain personal data. Django serves it after a login check
	# (students/views/media.py). If you move to object storage with signed URLs,
	# set MEDIA_PROTECTED=False and you may re-add a file_server block here.

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	reverse_proxy web:8000
}
